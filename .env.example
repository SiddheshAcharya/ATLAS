# ── identity (required by polite API pools; use a real address) ──────────────
ATLAS_CONTACT_EMAIL=you@college.edu

# ── LLM ─────────────────────────────────────────────────────────────────────
# LiteLLM routes by the prefix in config/models.yaml. Pick a profile and set its key(s).
#   hybrid → GROQ_API_KEY + GEMINI_API_KEY  (default: small jobs on Groq, long on Gemini)
#   groq   → GROQ_API_KEY                    (free tier, fast; 8k tokens/min cap)
#   cheap  → GEMINI_API_KEY                  (free tier, roomy)
#   cloud  → ANTHROPIC_API_KEY               (paid; best quality)
#   local  → OLLAMA_BASE_URL                 (no key, no network)
ATLAS_LLM_PROFILE=groq
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=      # optional 2nd key — client rotates to it on a Gemini quota error
# OLLAMA_BASE_URL=http://localhost:11434

# ── scholarly APIs ──────────────────────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=          # optional; without it you share a 100 req/5min pool
NCBI_API_KEY=                      # optional; raises PubMed to ~10 rps

# ── stores ──────────────────────────────────────────────────────────────────
# Defaults below are the no-Docker "lightweight" path. To use docker-compose.yml:
#   POSTGRES_DSN=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
#   NEO4J_URI=bolt://localhost:7687
#   QDRANT_URL=http://localhost:6333
#   GROBID_URL=http://localhost:8070
POSTGRES_DSN=sqlite+pysqlite:///./data/atlas.db
# NEO4J_URI=neo4j+s://<id>.databases.neo4j.io   # e.g. a Neo4j AuraDB Free instance
# Use the values from the credentials file Aura makes you download. On AuraDB Free the
# username and default database are the instance id, NOT "neo4j".
NEO4J_USER=neo4j
NEO4J_PASSWORD=atlaspassword
NEO4J_DATABASE=neo4j
QDRANT_URL=./data/qdrant          # ":memory:" | "./data/qdrant" | "http://localhost:6333"
GROBID_URL=http://localhost:8070   # docker compose; ingest uses PyMuPDF when this is down

# ── models ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# ── behaviour ───────────────────────────────────────────────────────────────
ATLAS_MODE=standard                # standard | deep | extra_deep
ATLAS_CACHE_ENABLED=true
ATLAS_LOG_LEVEL=INFO
ATLAS_DATA_DIR=./data              # pdfs/, tei/, cache/

# ── optional tracing ────────────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
